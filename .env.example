# Frontend Environment Variables
# URL pointing to the Node/Express backend API (defaults to http://localhost:5000/api if not provided)
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: Supabase credentials if communicating directly with Supabase SDK
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
